{
  "name": "@prismalens/review-telemetry-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply review-telemetry --local",
    "migrate:remote": "wrangler d1 migrations apply review-telemetry --remote",
    "migrate:list:local": "wrangler d1 migrations list review-telemetry --local",
    "migrate:list:remote": "wrangler d1 migrations list review-telemetry --remote",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
